# Include Python modules
recursive-include mixedsignal_gui *.py

# Include resources (icons, images, etc.)
recursive-include mixedsignal_gui/resources *

# Include MATLAB waveform files
recursive-include mixedsignal_gui/waveform_functions *.m
recursive-include mixedsignal_gui/waveform_functions *.mat

# Include bundled Sionna RT scenes (geometry + textures, not .blend sources)
recursive-include mixedsignal_gui/sionna_widget/hcro *.xml *.ply *.png
recursive-include mixedsignal_gui/sionna_widget/austin *.xml *.ply

# Include README and LICENSE
include README.md
include LICENSE
